Package: flexyBayes
Title: Flexible Bayesian Mixed Models with 'ASReml' and 'brms' Syntax
Version: 0.10.0
Authors@R: c(
    person("Max", "Moldovan", email = "max.moldovan@adelaide.edu.au",
           role = c("aut", "cre"),
           comment = c(ORCID = "0000-0001-9680-8474")),
    person("Emi", "Tanaka", role = "aut",
           comment = c(ORCID = "0000-0002-1455-259X")),
