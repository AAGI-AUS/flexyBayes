linters: linters_with_defaults(
    line_length_linter(80),
    object_name_linter = NULL,         # snake_case verified manually; legacy ASReml tokens
    indentation_linter = NULL,         # `air format` is the source of truth for indentation
    object_length_linter = NULL,       # long descriptive domain names are intentional (cf. object_name_linter)
    commented_code_linter = NULL,      # high false-positive rate on dash-banner headers + name-mapping docs
    assignment_linter = assignment_linter(operator = c("<-", "<<-"))  # `<<-` allowed explicitly: 4 uses, each accumulating into the enclosing function from a callback. Stated rather than left to a default, which differs between lintr versions and cost a red CI run
  )
exclusions: list(
    "tests/testthat/_snaps",
    "vignettes",
    "inst/examples",                   # illustrative cross-backend scripts; style-relaxed
    "tests/testthat" = list(line_length_linter = Inf),  # tests carry long fixtures + expected strings
    "R/fb_penalty.R" = list(line_length_linter = c(67, 68, 115, 116, 117, 118)),  # roxygen markdown table rows; a pipe-table row is one physical line and cannot be wrapped
    "data-raw/asreml_reference.R" = list(object_usage_linter = Inf),  # runs only under a separate R 4.5 install with the proprietary asreml package, which no CI machine has
    "data-raw/asreml_parity.R" = list(object_usage_linter = Inf, line_length_linter = Inf)  # needs the proprietary asreml package; its MD5 is stored in inst/extdata/asreml_parity.rds and checked by test-asreml-parity.R, so it is not reflowed
  )
