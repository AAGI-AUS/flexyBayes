# AI-assistant scratch dirs (also in .Rbuildignore) -- never enter git or the build
.claude/
.positai/
.cursor/

# Internal / non-package artefacts -- kept local, not part of the public package
paper/
dev-narrative/
NEWS_ARCHIVE.md
inst/backend_contract.md
inst/skip-ledger.md

# Host-local INLA-mapping verification artefacts -- per-host (carry INLA
# version, timestamp, agreement snapshot); must not enter shared history.
# Regenerated locally by the INLA-verification tests; absence on a fresh
# checkout is the intended fail-safe.
inst/extdata/inla-verification/

# Decision-knowledge archive -- local dev artefact, not part of the package.
ledger/

# pkgdown output (rebuilt by CI; not committed)
docs/

# Stress-harness outputs (generated; the harness scripts ship, the results
# directory is local-only).
tools/stress_results/

# testthat transient failed-test records
tests/testthat/_problems/

# Review documents stay in the private workspace archive
review/
.positai

# ASReml oracle run artefacts: rebuilt shim, scratch library, per-run results.
# Durable evidence is banked under inst/validation/asreml-4.2/ instead.
oracle_work/*

# The selection module's feasibility probes are the exception: the contract
# they decided cites them by path, and a specification that points at
# untracked files is a specification nobody can check. They are small text
# scripts and their logs, never a rebuilt shim or a scratch library.
!oracle_work/selection_bayes/

# Working notes kept locally, never shipped
/validation/
/oracle_work/
